#!/usr/bin/env bash
# Fake adb for the androidctl tests. Guest state lives in $FAKE.
[ "$1" = -s ] && shift 2
echo "adb $*" >>"$FAKE/calls"
case "$*" in
  "emu avd status")
    if [ -e "$FAKE/paused" ]; then echo "virtual device is stopped"; else echo "virtual device is running"; fi
    echo OK
    ;;
  "emu avd stop") touch "$FAKE/paused"; echo OK ;;
  "emu avd start") rm -f "$FAKE/paused"; echo OK ;;
  "emu kill") echo "OK: killing emulator, bye bye" ;;
  "shell getprop sys.boot_completed")
    # A paused guest never answers.
    [ -e "$FAKE/paused" ] && exec sleep 60
    cat "$FAKE/boot"
    ;;
  "get-state")
    if [ -e "$FAKE/unauthorized" ]; then
      echo unauthorized
    elif [ -e "$FAKE/offline" ]; then
      echo offline
    else
      echo device
    fi
    ;;
  "exec-out screencap -p") printf 'PNGDATA' ;;
  "shell uiautomator dump "*)
    # Fail once with a null root node, as a fresh boot can do.
    if [ -e "$FAKE/ui_broken" ]; then
      : >"$FAKE/window_dump.xml"
      echo "ERROR: null root node returned by UiTestAutomationBridge."
    elif [ -e "$FAKE/ui_ready" ]; then
      printf '<hierarchy rotation="0"/>' >"$FAKE/window_dump.xml"
    else
      : >"$FAKE/window_dump.xml"
      touch "$FAKE/ui_ready"
      echo "ERROR: null root node returned by UiTestAutomationBridge."
    fi
    ;;
  "exec-out cat /data/local/tmp/window_dump.xml")
    cat "$FAKE/window_dump.xml" 2>/dev/null || true
    ;;
  *) ;;
esac
