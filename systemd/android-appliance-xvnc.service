[Unit]
Description=Virtual display for the Android appliance
PartOf=android-appliance-emulator.service

[Service]
# No NoNewPrivileges=true. On an SELinux host such as Fedora, Xvnc has
# the type xserver_exec_t, and systemd starts it in the X server domain.
# NoNewPrivileges= blocks that domain change (nnp_transition), and then
# Xvnc cannot start. Options such as RestrictSUIDSGID= or
# SystemCallFilter= set NoNewPrivileges= too, so do not add them. The
# empty capability bounding set prevents a setuid program from giving
# capabilities to the processes of this unit.
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
ExecStart=/usr/bin/Xvnc :57 -geometry 1080x1920 -depth 24 -desktop Android -SecurityTypes None -AlwaysShared -rfbport -1 -rfbunixpath /run/android-appliance/vnc.sock -rfbunixmode 0600 -nolisten tcp
ExecStartPost=/bin/sh -c 'until /usr/bin/xdpyinfo -display :57 >/dev/null 2>&1 && [ -S /run/android-appliance/vnc.sock ]; do /usr/bin/sleep 0.2; done'
TimeoutStartSec=30s

# User, Group and ReadWritePaths are set by the 50-appliance.conf
# drop-in that install.sh writes.
