[Unit]
Description=Idle policy for the Android appliance
BindsTo=android-appliance-emulator.service
After=android-appliance-emulator.service

[Timer]
OnActiveSec=30s
OnUnitActiveSec=30s
AccuracySec=5s

# There is no [Install] section. The emulator unit wants this timer.
# Because of BindsTo=, an enabled timer would start Android at boot.
