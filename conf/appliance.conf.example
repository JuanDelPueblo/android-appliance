# Configuration of the Android appliance.
#
# install.sh copies this file to /etc/android-appliance/appliance.conf.
# Syntax: KEY=value, one key per line, no spaces and no quotes. A value
# that is already in the environment keeps the environment value. Edit
# the file, then run install.sh again to apply a change.

# Persistent appliance directory. It holds the AVD, userdata and adb keys.
APPLIANCE_STATE_DIR=/var/lib/android-appliance

# User and group that run the emulator and operate it.
APPLIANCE_USER=android-appliance
APPLIANCE_GROUP=android-appliance

# Name of the AVD in the state directory.
APPLIANCE_AVD_NAME=android

# Android API level of the system image. The Google APIs Play Store
# image must exist for this level and x86_64.
APPLIANCE_API_LEVEL=36

# Stop Android after this many minutes without use. The next use cold
# boots with the existing userdata.
APPLIANCE_IDLE_STOP_MINUTES=60

# Guest hardware. A change preserves userdata but forces a cold boot.
APPLIANCE_MEMORY_MIB=4096
APPLIANCE_CORES=4
APPLIANCE_DISK_SIZE=32G

# Emulator -gpu mode. swiftshader works on every headless host; host
# needs a usable GPU and EGL. Snapshot load/save is always disabled.
APPLIANCE_GPU=swiftshader

# Browser display through scrcpy and noVNC. 1 serves the device screen
# at the loopback port below; 0 disables it.
APPLIANCE_DISPLAY_ENABLED=1
APPLIANCE_DISPLAY_PORT=6090

# Android SDK directory. install.sh installs the pinned SDK here with
# scripts/provision-sdk.sh.
APPLIANCE_ANDROID_HOME=/opt/android-sdk

# 1: install.sh installs the pinned SDK packages. 0: you manage the SDK,
# and install.sh only checks it.
APPLIANCE_SDK_MANAGED=1

# Revisions of the SDK packages. conf/sdk.lock pins the archive and the
# SHA-256 of each revision. An unset key selects the default revision
# of the lock (for the system image: the default for
# APPLIANCE_API_LEVEL). Set a key to keep a revision when a new project
# version changes the default. The command-line tools (sdkmanager) are
# not necessary; set their key to install them. They need Java.
#APPLIANCE_SDK_EMULATOR_VERSION=37.2.12
#APPLIANCE_SDK_PLATFORM_TOOLS_VERSION=37.0.1
#APPLIANCE_SDK_IMAGE_REVISION=7
#APPLIANCE_SDK_CMDLINE_TOOLS_VERSION=23.0

# Download location of the SDK archives, for example a local mirror.
#APPLIANCE_SDK_REPOSITORY=https://dl.google.com/android/repository
