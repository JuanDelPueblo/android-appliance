#!/usr/bin/env bash
# avd-init: create the persistent AVD on first start and keep the managed
# hardware keys in line with the NixOS options.
#
# The AVD format is two small ini files. Writing them directly avoids a JDK
# and avdmanager at runtime. The emulator creates userdata on first boot.
set -euo pipefail

: "${ANDROID_AVD_HOME:?}" "${AVD_NAME:?}" "${AVD_SYSTEM_IMAGE:?}" "${AVD_API:?}"
: "${AVD_TAG:?}" "${AVD_RAM_MIB:?}" "${AVD_CORES:?}" "${AVD_DISK_SIZE:?}"

avd_dir=$ANDROID_AVD_HOME/$AVD_NAME.avd
config=$avd_dir/config.ini
registry=$ANDROID_AVD_HOME/$AVD_NAME.ini

canon() {
  # Canonicalize without requiring existence. realpath comes from coreutils.
  realpath -m "$1" 2>/dev/null || printf '%s' "$1"
}

set_key() {
  local key=$1 value=$2 current
  # The emulator can write sizes back with a unit, for example 2048M.
  # Do not touch an equal value: a config change forces a cold boot.
  current=$(read_key "$key")
  [ "${current%%[MG]*}" = "$value" ] && return
  if [ -n "$current" ]; then
    sed -i "s|^$key *= *.*|$key=$value|" "$config"
  else
    echo "$key=$value" >>"$config"
  fi
}

read_key() {
  # The emulator rewrites config.ini as "key = value" with spaces.
  sed -n "s/^$1 *= *//p" "$config" | head -n 1
}

mkdir -p "$ANDROID_AVD_HOME" "$HOME/.android"

# The emulator follows path= in the registry .ini, not the directory we
# inspect below. A stale absolute path (for example after moving stateDir)
# would make avd-init validate one AVD while the emulator launches another,
# potentially with a read-only sandbox. Refuse instead of following it.
if [ -f "$registry" ]; then
  reg_path=$(sed -n 's/^path=//p' "$registry" | head -n 1)
  if [ -n "$reg_path" ] && [ "$(canon "$reg_path")" != "$(canon "$avd_dir")" ]; then
    echo "avd-init: registry '$registry' points to '$reg_path'," >&2
    echo "avd-init: but services.android-appliance.stateDir expects '$avd_dir'." >&2
    echo "avd-init: refusing to inspect one AVD while the emulator would launch another." >&2
    echo "avd-init: point stateDir at the live tree (for this path: the parent of '$(dirname "$reg_path")')," >&2
    echo "avd-init: or remove the stale registry entry; not touching the AVD." >&2
    exit 1
  fi
fi

if [ ! -f "$config" ]; then
  echo "avd-init: creating AVD '$AVD_NAME' in $avd_dir"
  mkdir -p "$avd_dir"
  cat >"$ANDROID_AVD_HOME/$AVD_NAME.ini" <<EOF
avd.ini.encoding=UTF-8
path=$avd_dir
path.rel=avd/$AVD_NAME.avd
target=android-$AVD_API
EOF
  cat >"$config" <<EOF
avd.ini.encoding=UTF-8
AvdId=$AVD_NAME
avd.ini.displayname=$AVD_NAME
abi.type=x86_64
hw.cpu.arch=x86_64
image.sysdir.1=$AVD_SYSTEM_IMAGE/
tag.id=$AVD_TAG
tag.display=Google Play
PlayStore.enabled=true
disk.dataPartition.size=$AVD_DISK_SIZE
fastboot.forceColdBoot=no
fastboot.forceFastBoot=yes
hw.lcd.width=1080
hw.lcd.height=1920
hw.lcd.density=420
hw.keyboard=yes
hw.mainKeys=no
hw.gpu.enabled=yes
hw.audioInput=no
hw.audioOutput=no
hw.camera.back=none
hw.camera.front=none
showDeviceFrame=no
EOF
else
  # Do not modify an existing AVD. Swapping the OS under existing userdata
  # would be unsafe, so validate the image and stop on a mismatch instead.
  # The API level in the system image path is the authoritative one.
  current_image=$(read_key image.sysdir.1)
  case "$current_image" in
    "system-images/android-$AVD_API/$AVD_TAG/x86_64/" | "system-images/android-$AVD_API/$AVD_TAG/x86_64")
      ;;
    *)
      echo "avd-init: existing AVD '$AVD_NAME' uses '${current_image%/}', but" >&2
      echo "avd-init: services.android-appliance.apiLevel is $AVD_API ($AVD_SYSTEM_IMAGE/)." >&2
      echo "avd-init: apiLevel does not upgrade existing AVDs; use the matching level or recreate the AVD." >&2
      exit 1
      ;;
  esac
  echo "avd-init: AVD '$AVD_NAME' exists; keeping userdata"
  # The registry must exist and point here; recreate it if it is missing.
  # A mismatched path was already refused above, so writing the expected
  # path is safe and repairs a deleted registry file.
  if [ ! -f "$registry" ]; then
    cat >"$registry" <<EOF
avd.ini.encoding=UTF-8
path=$avd_dir
path.rel=avd/$AVD_NAME.avd
target=android-$AVD_API
EOF
  fi
fi

# A changed value makes the emulator cold boot once instead of restoring the
# Quick Boot snapshot. Userdata is kept.
set_key hw.ramSize "$AVD_RAM_MIB"
set_key hw.cpu.ncore "$AVD_CORES"
# The browser display is 1080x1920, so keep adopted AVDs at the same native
# size instead of a stale low resolution. Userdata is kept; one cold boot.
set_key hw.lcd.width 1080
set_key hw.lcd.height 1920
set_key hw.lcd.density 420

# Without a window there is no Quick Boot dialog, and the emulator does not
# save the snapshot on exit unless this choice is set.
echo "saveOnExit=true" >"$avd_dir/quickbootChoice.ini"
