#!/usr/bin/env python3
"""Print the idle time of the X display in milliseconds.

This replaces the xprintidle command, which Fedora does not package. It
queries the MIT-SCREEN-SAVER extension through ctypes, so it needs no
compiled helper. Exit status 1 means "no idle value"; callers then treat
the display input as unused.
"""

import ctypes
import ctypes.util
import os
import sys


class ScreenSaverInfo(ctypes.Structure):
    _fields_ = [
        ("window", ctypes.c_ulong),
        ("state", ctypes.c_int),
        ("kind", ctypes.c_int),
        ("til_or_since", ctypes.c_ulong),
        ("idle", ctypes.c_ulong),
        ("eventMask", ctypes.c_ulong),
    ]


def main() -> int:
    if not os.environ.get("DISPLAY"):
        return 1
    try:
        xss = ctypes.CDLL(ctypes.util.find_library("Xss"))
        x11 = ctypes.CDLL(ctypes.util.find_library("X11"))
    except OSError:
        return 1
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    xss.XScreenSaverAllocInfo.restype = ctypes.POINTER(ScreenSaverInfo)
    xss.XScreenSaverQueryInfo.restype = ctypes.c_int
    xss.XScreenSaverQueryInfo.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ScreenSaverInfo)]

    display = x11.XOpenDisplay(None)
    if not display:
        return 1
    try:
        info = xss.XScreenSaverAllocInfo()
        if not info:
            return 1
        root = x11.XDefaultRootWindow(display)
        if xss.XScreenSaverQueryInfo(display, root, info) != 1:
            return 1
        print(info.contents.idle)
    finally:
        x11.XCloseDisplay(display)
    return 0


if __name__ == "__main__":
    sys.exit(main())
